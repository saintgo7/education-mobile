# ============================================
# 게이트웨이 설정
# ============================================
API_GATEWAY_PORT=3000
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=*

# ============================================
# 데이터베이스
# ============================================
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=password123
MONGODB_URI=mongodb://root:password123@mongodb:27017
REDIS_URL=redis://redis:6379

# ============================================
# 마이크로서비스 URL
# ============================================
AUTH_SERVICE_URL=http://auth-service:3001
COURSE_SERVICE_URL=http://course-service:3002
PAYMENT_SERVICE_URL=http://payment-service:3003
VIDEO_SERVICE_URL=http://video-service:3004
ANALYTICS_SERVICE_URL=http://analytics-service:3005
COLLABORATION_SERVICE_URL=http://collaboration-service:3006
EMAIL_SERVICE_URL=http://email-service:3007
RECOMMENDATION_SERVICE_URL=http://recommendation-service:3008

# ============================================
# Stripe 설정
# ============================================
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_secret

# ============================================
# PayPal 설정
# ============================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ============================================
# AWS S3 설정 (비디오 스토리지)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=education-videos

# ============================================
# 이메일 설정
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=noreply@education-mobile.com

# ============================================
# 프론트엔드 설정
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000

# ============================================
# 모니터링 설정
# ============================================
LOG_LEVEL=info
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ============================================
# 환경
# ============================================
NODE_ENV=development
DEBUG=false

# ============================================
# 배포 설정
# ============================================
DEPLOY_HOST=your_server_ip_or_domain
DEPLOY_USER=deploy_user
DEPLOY_PORT=22
